<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_consignment" name="Portal My Home: Consignment Menu"
              inherit_id="portal.portal_my_home" priority="99">
        <xpath expr="//div[@id='portal_client_category']" position="inside">

            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/otters_consignment/static/src/img/verzending_icon.png'"/>
                <t t-set="title">Mijn Inzendingen</t>
                <t t-set="text">Bekijk de status van je opgestuurde kleren</t>
                <t t-set="url" t-value="'/my/consignments'"/>
                <t t-set="config_card" t-value="True"/>
            </t>

        </xpath>
    </template>

    <template id="portal_my_consignments" name="Mijn Consignaties">
        <t t-call="portal.portal_layout">
            <div class="container">
                <h3>Mijn Inzendingen</h3>
                <t t-if="not submissions">
                    <div class="alert alert-info" role="alert">
                        Je hebt nog geen inzendingen.
                    </div>
                </t>
                <t t-if="submissions">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Datum</th>
                                <th>Status</th>
                                <th>Uitbetaalmethode</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="submissions" t-as="submission">
                                <td>
                                    <a t-att-href="'/my/consignments/%s' % submission.id">
                                        <span t-field="submission.name"/>
                                    </a>
                                </td>
                                <td><span t-field="submission.submission_date" t-options="{'widget': 'date'}"/></td>
                                <td><span t-field="submission.state"/></td>
                                <td><span t-field="submission.payout_method"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <div t-if="pager" class="o_portal_pager">
                    <t t-call="portal.pager"/>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_consignment_submission" name="Consignatie Details">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="mb-0">
                                Inzending: <b t-field="submission.name"/>
                            </h5>
                            <div class="text-muted">
                                Status: <span t-field="submission.state"/>
                            </div>
                            <div class="small">
                                <i class="fa fa-calendar me-1"/> Ontvangen:
                                <span t-field="submission.submission_date" t-options='{"widget": "date"}'/>

                                <t t-if="submission.date_published">
                                    <span class="mx-2">|</span>
                                    <i class="fa fa-globe me-1 text-success"/> Online sinds:
                                    <span t-field="submission.date_published" t-options='{"widget": "date"}' class="fw-bold text-success"/>
                                </t>
                            </div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <small class="text-muted">Uitbetaal-afspraak:</small>

                            <t t-if="submission.state != 'cancel'">
                                <a href="#" data-bs-toggle="modal" data-bs-target="#editSettingsModal" class="ms-2 text-decoration-none">
                                    <i class="fa fa-pencil"/> Wijzig
                                </a>
                            </t>
                            <br/>

                            <strong t-if="submission.payout_method == 'cash'">
                                <span t-out="'{:.0f}'.format(submission.payout_percentage * 100)"/>% in Cash
                            </strong>
                            <strong t-if="submission.payout_method == 'coupon'">
                                <span t-out="'{:.0f}'.format(submission.payout_percentage * 100)"/>% in Tegoedbon
                            </strong>

                            <div t-if="submission.x_iban" class="small text-muted mt-1">
                                <i class="fa fa-credit-card"/> <span t-field="submission.x_iban"/>
                            </div>
                        </div>

                        <div class="modal fade" id="editSettingsModal" tabindex="-1" role="dialog" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <form action="/my/consignments/update" method="POST" id="consignment_update_form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="submission_id" t-att-value="submission.id"/>

                                        <div class="modal-header">
                                            <h5 class="modal-title">Instellingen Wijzigen</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Hoe wil je uitbetaald worden?</label>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="payout_method" id="method_coupon" value="coupon"
                                                           t-att-checked="submission.payout_method == 'coupon' and 'checked'"/>
                                                    <label class="form-check-label" for="method_coupon">
                                                        Uitbetaald als waardebon (<t t-out="system_coupon_perc"/>% van de verkoopprijs)
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="payout_method" id="method_cash" value="cash"
                                                           t-att-checked="submission.payout_method == 'cash' and 'checked'"/>
                                                    <label class="form-check-label" for="method_cash">
                                                        Uitbetaald op rekeningnummer (<t t-out="system_cash_perc"/>% van de verkoopprijs)
                                                    </label>
                                                </div>
                                                <small class="text-muted">
                                                    Let op: Dit past het percentage aan voor alle producten die nog <u>niet</u> zijn uitbetaald.
                                                </small>
                                            </div>

                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label for="x_iban_modal" class="form-label fw-bold">Bankrekeningnummer (IBAN)</label>
                                                    <input type="text" class="form-control" name="x_iban" id="x_iban_modal"
                                                           t-att-value="submission.x_iban" placeholder="BE00 0000 0000 0000"/>

                                                    <div id="iban_error_msg_modal" class="text-danger small mt-1 d-none">
                                                        <i class="fa fa-exclamation-triangle"/> Gelieve een geldig IBAN nummer in te vullen.
                                                    </div>

                                                    <small class="text-muted">
                                                        We bewaren dit nummer voor toekomstige cash uitbetalingen.
                                                    </small>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                                            <button type="submit" class="btn btn-primary">Opslaan</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3 pt-2 border-top">
                        <div class="col-md-6">
                            <small class="text-muted">Actie bij niet-weerhouden items:</small><br/>
                            <i class="fa fa-hand-holding-heart text-info" t-if="submission.action_unaccepted == 'donate'"/>
                            <i class="fa fa-truck text-warning" t-if="submission.action_unaccepted == 'return'"/>
                            <span t-field="submission.action_unaccepted"/>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <small class="text-muted">Actie bij niet-verkocht (na 1 jaar):</small><br/>
                            <span t-field="submission.action_unsold"/>
                            <i class="fa fa-hand-holding-heart text-info" t-if="submission.action_unsold == 'donate'"/>
                            <i class="fa fa-truck text-warning" t-if="submission.action_unsold == 'return'"/>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <t t-if="submission.discount_percentage > 0">
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="fa fa-percent fa-2x me-3"/>
                            <div>
                                <h5 class="alert-heading mb-1">
                                    Promotie Actief: <t t-out="submission.discount_percentage"/>% Korting
                                </h5>
                                <p class="mb-0">
                                    De prijzen van je items zijn tijdelijk verlaagd om de verkoop te stimuleren.
                                    <br/>
                                    <strong>Reden:</strong> <span t-field="submission.discount_reason"/>
                                </p>
                            </div>
                        </div>
                    </t>
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="stock-tab" data-bs-toggle="tab" href="#stock" role="tab">
                                In Voorraad (<t t-out="len(stock_products)"/>)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="unpaid-tab" data-bs-toggle="tab" href="#unpaid" role="tab">
                                Verkocht: Nog te Betalen (<t t-out="len(aggregated_unpaid)"/>)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="paid-tab" data-bs-toggle="tab" href="#paid" role="tab">
                                Verkocht: Reeds Uitbetaald (<t t-out="len(aggregated_paid)"/>)
                            </a>
                        </li>

                        <li class="nav-item" t-if="removed_products">
                            <a class="nav-link text-warning" id="removed-tab" data-bs-toggle="tab" href="#removed" role="tab">
                                Uit Collectie (<t t-out="len(removed_products)"/>)
                            </a>
                        </li>

                        <li class="nav-item" t-if="submission.rejected_line_ids">
                            <a class="nav-link text-danger" id="rejected-tab" data-bs-toggle="tab" href="#rejected" role="tab">
                                Niet Weerhouden (<t t-out="len(submission.rejected_line_ids)"/>)
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content pt-3" id="myTabContent">

                        <div class="tab-pane fade show active" id="stock" role="tabpanel" aria-labelledby="stock-tab">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th width="60">Foto</th>
                                        <th>Product</th>
                                        <th class="text-end">Verkoopprijs</th>
                                        <th class="text-end">Commissie</th>
                                        <th class="text-end">Jouw Deel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="stock_products" t-as="product">
                                        <td>
                                            <img t-att-src="'/web/image/product.template/%s/image_128' % product.id"
                                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;"/>
                                        </td>
                                        <td><span t-field="product.name"/></td>
                                        <td class="text-end">
                                            <t t-if="product.compare_list_price and product.compare_list_price > product.list_price">
                                                <span class="text-muted text-decoration-line-through me-1"
                                                      t-field="product.compare_list_price"
                                                      t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                                <br/>
                                            </t>

                                            <span t-field="product.list_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"
                                                  t-att-class="'fw-bold text-danger' if product.compare_list_price else ''"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="'{:.0f}'.format(submission.payout_percentage * 100)"/>%
                                        </td>
                                        <td class="text-end">
                                            <span t-out="product.list_price * submission.payout_percentage"
                                                  t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"
                                                  class="fw-bold text-success"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="bg-light">
                                        <td colspan="4" class="text-end">
                                            <strong>Totaal te verdienen bij verkoop:</strong>
                                        </td>
                                        <td class="text-end">
                                            <strong t-out="total_payout_stock"
                                                    t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="tab-pane fade" id="unpaid" role="tabpanel" aria-labelledby="unpaid-tab">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th width="60">Foto</th>
                                        <th>Product</th>
                                        <th class="text-end">Aantal</th>
                                        <th class="text-end">Verkoopprijs</th>
                                        <th class="text-end">Commissie</th>
                                        <th class="text-end">Jouw Uitbetaling</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="aggregated_unpaid" t-as="line">
                                        <td>
                                            <img t-att-src="'/web/image/product.template/%s/image_128' % line['product'].id"
                                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;"/>
                                        </td>
                                        <td><span t-out="line['name']"/></td>
                                        <td class="text-end"><span t-out="line['qty']"/> st</td>
                                        <td class="text-end">
                                            <t t-set="prod" t-value="line['product']"/>
                                            <t t-set="unit_price" t-value="line['price_sold'] / line['qty']"/>

                                            <span t-out="line['price_sold']"
                                                  t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"
                                                  class="fw-bold"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="'{:.0f}'.format(line['percentage'] * 100)"/>%
                                        </td>
                                        <td class="text-end">
                                            <span t-out="line['payout']" t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="bg-light">
                                        <td colspan="5" class="text-end">
                                            <strong>Totaal nog uit te betalen:</strong>
                                        </td>
                                        <td class="text-end">
                                            <strong t-out="total_payout_unpaid" t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="tab-pane fade" id="paid" role="tabpanel" aria-labelledby="paid-tab">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th width="60">Foto</th>
                                        <th>Product</th>
                                        <th class="text-end">Datum</th>
                                        <th class="text-end">Aantal</th>
                                        <th class="text-end">Verkoopprijs</th>
                                        <th class="text-end">Commissie</th>
                                        <th class="text-end">Uitbetaald Bedrag</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="aggregated_paid" t-as="line">
                                        <td>
                                            <img t-att-src="'/web/image/product.template/%s/image_128' % line['product'].id"
                                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;"/>
                                        </td>
                                        <td><span t-out="line['name']"/></td>
                                        <td class="text-end">
                                            <span t-out="line['date']" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td class="text-end"><span t-out="line['qty']"/> st</td>
                                        <td class="text-end">
                                            <span t-out="line['price_sold']"
                                                  t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"
                                                  class="fw-bold"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="'{:.0f}'.format(line['percentage'] * 100)"/>%
                                        </td>
                                        <td class="text-end">
                                            <span t-out="line['payout']" t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold bg-light border-top">
                                        <td colspan="6" class="text-end">Totaal Reeds Uitbetaald:</td>

                                        <td class="text-end text-success">
                                            <span t-out="total_payout_paid"
                                                  t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="tab-pane fade" id="removed" role="tabpanel">
                            <div class="alert alert-light border mb-3">
                                <i class="fa fa-info-circle text-warning"/> Deze items zijn uit de verkoop gehaald (niet verkocht).
                            </div>
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th width="60">Foto</th>
                                        <th>Product</th>
                                        <th>Reden</th>
                                        <th class="text-end">Oorspr. Prijs</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="removed_products" t-as="product">
                                        <td>
                                            <img t-att-src="'/web/image/product.template/%s/image_128' % product.id"
                                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px;"/>
                                        </td>
                                        <td>
                                            <span t-field="product.name"/>
                                            <br/>
                                            <small class="text-muted"><span t-field="product.default_code"/></small>
                                        </td>
                                        <td>
                                            <t t-if="product.x_unsold_reason == 'charity'">
                                                <span class="badge text-bg-success">Geschonken aan goed doel</span>
                                            </t>
                                            <t t-elif="product.x_unsold_reason == 'returned'">
                                                <span class="badge text-bg-info">Teruggestuurd naar jou</span>
                                            </t>
                                            <t t-elif="product.x_unsold_reason == 'new_collection'">
                                                <span class="badge text-bg-secondary">Plaats gemaakt voor 'nieuwe' collectie</span>
                                            </t>
                                            <t t-elif="product.x_unsold_reason == 'other'">
                                                <span class="badge text-bg-secondary"><t t-out="product.x_unsold_reason_other or 'Andere reden'"/></span>
                                            </t>
                                            <t t-else="">
                                                <span t-field="product.x_unsold_reason"/>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': submission.supplier_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="tab-pane fade" id="rejected" role="tabpanel" aria-labelledby="rejected-tab">
                            <div class="alert alert-light border mb-3">
                                <i class="fa fa-info-circle text-info"/> Deze items zijn niet online geplaatst.
                                Zie uw keuze hierboven ("Actie bij niet-weerhouden") voor wat hiermee gebeurt.
                            </div>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Omschrijving</th>
                                        <th>Reden</th>
                                        <th>Extra Info</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="submission.rejected_line_ids" t-as="line">
                                        <td><span t-field="line.product_name"/></td>
                                        <td><span t-field="line.reason"/></td>
                                        <td><span t-field="line.note"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="portal_my_consignments_button" inherit_id="otters_consignment.portal_my_consignments">
        <xpath expr="//h3" position="replace">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Mijn Inzendingen</h3>
                <a href="/my/consignments/settings" class="btn btn-outline-primary">
                    <i class="fa fa-cogs"/> Mijn Voorkeuren
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_consignment_settings" name="Mijn Voorkeuren">
        <t t-call="portal.portal_layout">
            <div class="container">
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Standaard Instellingen</h5>
                    </div>
                    <div class="card-body">
                        <form action="/my/consignments/settings/save" method="POST" id="consignment_settings_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <h5 class="text-primary mb-3"><i class="fa fa-money me-2"/>1. Uitbetaling</h5>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Voorkeur Uitbetaalmethode</label>

                                    <div class="form-check p-3 border rounded mb-2">
                                        <input class="form-check-input" type="radio" name="payout_method" id="pref_coupon" value="coupon"
                                               t-att-checked="partner.x_payout_method == 'coupon' and 'checked'"/>
                                        <label class="form-check-label w-100" for="pref_coupon">
                                            <strong>Uitbetaald als waardebon (<t t-out="system_coupon_perc"/>% van de verkoopprijs)</strong>
                                            <br/>
                                            <small class="text-muted">Je ontvangt een code om te shoppen in de webshop.</small>
                                        </label>
                                    </div>

                                    <div class="form-check p-3 border rounded">
                                        <input class="form-check-input" type="radio" name="payout_method" id="pref_cash" value="cash"
                                               t-att-checked="partner.x_payout_method == 'cash' and 'checked'"/>
                                        <label class="form-check-label w-100" for="pref_cash">
                                            <strong>Uitbetaald op rekeningnummer (<t t-out="system_cash_perc"/>% van de verkoopprijs)</strong>
                                            <br/>
                                            <small class="text-muted">Wij storten het bedrag op je rekening.</small>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label for="x_iban" class="form-label fw-bold">Jouw Rekeningnummer (IBAN)</label>
                                    <input type="text" class="form-control" name="x_iban" id="x_iban"
                                           t-att-value="current_iban" placeholder="BE00 0000 0000 0000"/>

                                    <div id="iban_error_msg" class="text-danger small mt-1 d-none">
                                        <i class="fa fa-exclamation-triangle"/> Gelieve een geldig IBAN nummer in te vullen.
                                    </div>

                                    <small class="text-muted">
                                        Verplicht indien je kiest voor uitbetaling op rekening.
                                    </small>
                                </div>
                            </div>

                            <div class="alert alert-info border-info bg-light">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="update_existing" id="update_existing" value="True" checked="checked"/>
                                    <label class="form-check-label fw-bold text-dark" for="update_existing">
                                        Pas deze financiële instellingen (methode &amp; IBAN) direct toe op mijn lopende inzendingen.
                                    </label>
                                    <div class="form-text mt-1">
                                        Dit geldt voor alle inzendingen die nog niet zijn afgerond/uitbetaald.
                                    </div>
                                </div>
                            </div>

                            <hr class="my-5"/>

                            <h5 class="text-primary mb-3"><i class="fa fa-recycle me-2"/>2. Wat met je kleding?</h5>
                            <p class="text-muted small mb-4">
                                Deze instellingen worden opgeslagen als <strong>standaard voor toekomstige inzendingen</strong>.
                                <br/>
                                Lopende inzendingen behouden hun oorspronkelijke afspraak (om logistieke redenen).
                            </p>

                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Wat met niet-weerhouden items?</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="action_unaccepted" id="ua_donate" value="donate"
                                               t-att-checked="(partner.x_action_unaccepted == 'donate' or not partner.x_action_unaccepted) and 'checked'"/>
                                        <label class="form-check-label" for="ua_donate">
                                            Schenken aan goed doel
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="action_unaccepted" id="ua_return" value="return"
                                               t-att-checked="partner.x_action_unaccepted == 'return' and 'checked'"/>
                                        <label class="form-check-label" for="ua_return">
                                            Terugsturen (€7,50 verzendkosten)
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Wat met kleding die na een jaar niet verkocht is?</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="action_unsold" id="us_donate" value="donate"
                                               t-att-checked="(partner.x_action_unsold == 'donate' or not partner.x_action_unsold) and 'checked'"/>
                                        <label class="form-check-label" for="us_donate">
                                            Schenken aan goed doel
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="action_unsold" id="us_return" value="return"
                                               t-att-checked="partner.x_action_unsold == 'return' and 'checked'"/>
                                        <label class="form-check-label" for="us_return">
                                            Terugsturen (€7,50 verzendkosten)
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                                <a href="/my/consignments" class="btn btn-secondary">Annuleren</a>
                                <button type="submit" class="btn btn-primary px-4">Instellingen Opslaan</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_home_menu_consignment_breadcrumbs" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">

            <li t-if="page_name == 'consignment_list' or page_name == 'consignment_submission' or page_name == 'consignment_settings'"
                t-attf-class="breadcrumb-item #{'active' if page_name == 'consignment_list' else ''}">

                <a t-if="page_name != 'consignment_list'" href="/my/consignments">Mijn Inzendingen</a>
                <t t-else="">Mijn Inzendingen</t>
            </li>

            <li t-if="page_name == 'consignment_submission'" class="breadcrumb-item active">
                <span t-field="submission.name"/>
            </li>

            <li t-if="page_name == 'consignment_settings'" class="breadcrumb-item active">
                Voorkeuren
            </li>

        </xpath>
    </template>
</odoo>