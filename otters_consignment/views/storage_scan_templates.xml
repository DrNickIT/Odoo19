<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="storage_scan_page" name="Kleding scannen">
        <t t-call="website.layout">
            <main class="container my-4 o_storage_scan">
                <div class="mx-auto" style="max-width: 640px;">
                    <h1>Kleding in een opbergzak plaatsen</h1>
                    <p class="text-muted">
                        Scan de productcode en de zakcode. De zak blijft na het koppelen ingevuld,
                        zodat je meerdere kledingstukken na elkaar in dezelfde zak kunt plaatsen.
                    </p>

                    <form id="storage_scan_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label for="storage_product_code" class="form-label">Productcode</label>
                            <div class="input-group">
                                <input id="storage_product_code"
                                       name="product_code"
                                       type="text"
                                       class="form-control form-control-lg"
                                       autocomplete="off"
                                       required="required"
                                       placeholder="Bijvoorbeeld THO-123"/>
                                <button type="button"
                                        class="btn btn-outline-secondary o_storage_scan_camera"
                                        data-target="storage_product_code">
                                    Scan label
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="storage_bag_code" class="form-label">Zakcode</label>
                            <div class="input-group">
                                <input id="storage_bag_code"
                                       name="bag_code"
                                       type="text"
                                       class="form-control form-control-lg"
                                       autocomplete="off"
                                       required="required"
                                       placeholder="Bijvoorbeeld 12"/>
                                <button type="button"
                                        class="btn btn-outline-secondary o_storage_scan_camera"
                                        data-target="storage_bag_code">
                                    Scan zak
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Koppel product aan zak
                        </button>
                        <input id="storage_scan_image"
                               type="file"
                               accept="image/*"
                               capture="environment"
                               class="d-none"/>
                    </form>

                    <div id="storage_scan_camera_modal"
                         class="o_storage_scan_camera_modal d-none"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="storage_scan_camera_title">
                        <div class="o_storage_scan_camera_dialog">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h2 id="storage_scan_camera_title" class="h4 mb-0">Code scannen</h2>
                                <button type="button"
                                        class="btn-close o_storage_scan_camera_cancel"
                                        aria-label="Cameravenster sluiten"></button>
                            </div>
                            <p class="text-muted mb-2">
                                Houd de code recht en scherp binnen het kader.
                            </p>
                            <div class="o_storage_scan_camera_view">
                                <video id="storage_scan_camera_video"
                                       autoplay="autoplay"
                                       muted="muted"
                                       playsinline="playsinline"></video>
                                <div class="o_storage_scan_camera_frame" aria-hidden="true"/>
                                <p id="storage_scan_camera_loading"
                                   class="o_storage_scan_camera_loading">
                                    Camera starten…
                                </p>
                            </div>
                            <p id="storage_scan_camera_torch_status"
                               class="text-warning small mt-2 d-none"
                               role="status"
                               aria-live="polite"></p>
                            <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
                                <button type="button"
                                        class="btn btn-outline-warning o_storage_scan_camera_torch d-none"
                                        aria-pressed="false">
                                    Lamp aan
                                </button>
                                <button type="button"
                                        class="btn btn-primary o_storage_scan_camera_capture">
                                    Maak foto
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary o_storage_scan_camera_choose">
                                    Kies foto
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary o_storage_scan_camera_cancel">
                                    Annuleren
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="storage_scan_status"
                         class="alert mt-3 d-none"
                         role="status"
                         aria-live="polite"></div>
                </div>
            </main>
        </t>
    </template>
</odoo>
